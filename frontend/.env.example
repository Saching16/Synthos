# Optional. Leave unset during `npm run dev` so requests go to the Vite dev server
# and vite.config.ts proxies /health, /upload, /documents, /chat, /handbook to FastAPI.
# VITE_API_BASE=http://127.0.0.1:8000

# Override proxy target when the API is not on 127.0.0.1:8000 (dev only).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
