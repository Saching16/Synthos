# OpenRouter — one key for chat (OpenAI-compatible /v1/chat/completions) and embeddings (/v1/embeddings)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free chat router — often too loose for LightRAG entity/relation extraction (hybrid/local/global).
# For graph-based modes use a structured model, e.g. OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=openrouter/free
# Embedding model id on OpenRouter (often billed per token; see their pricing / models list)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# Optional: attribution headers OpenRouter recommends
# OPENROUTER_HTTP_REFERER=https://localhost
# OPENROUTER_APP_TITLE=Handbook Generator

# Supabase Postgres (use db.*.supabase.co:5432 "Direct connection" from the dashboard)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# After enabling the Supabase IPv4 add-on (or on IPv4-only networks), set to 1 so hostnames
# resolve to IPv4 literals before connect (avoids broken IPv6 paths). Pool + LightRAG both use this.
SUPABASE_POSTGRES_PREFER_IPV4=0
# If SUPABASE_DB_URL is a transaction pooler (:6543), set a direct URL for LightRAG only:
# SUPABASE_DIRECT_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# LightRAG reads POSTGRES_*; the app fills them from SUPABASE_DIRECT_DB_URL or SUPABASE_DB_URL at startup.
# TLS MITM / cert issues (dev only): LIGHTRAG_PG_INSECURE_SSL=1
#
# If logs show IPv6 from dig then "errno 65 No route to host", your LAN has no working IPv6 to
# Supabase: try another network, enable IPv6, add Supabase IPv4 for the DB, or use the Session
# pooler connection string (port 5432) from the dashboard as SUPABASE_DIRECT_DB_URL if it works for you.

# Optional: Supabase REST / Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LightRAG working directory (NetworkX graph + local cache)
LIGHTRAG_WORKING_DIR=.lightrag

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
